---
# Define the baseline style
BasedOnStyle: LLVM

# Indentation settings
IndentWidth: 4
TabWidth: 4
UseTab: Never

# Optional but helpful: Continuation indent (for line breaks in long expressions)
ContinuationIndentWidth: 4

# Optional but helpful: Indent cases inside a switch statement
IndentCaseLabels: true
# Aligns the equals signs of consecutive assignments and enum values
AlignConsecutiveAssignments: true


# Aligns the variable names of consecutive declarations
AlignConsecutiveDeclarations: true

# Optional: Aligns trailing comments perfectly
AlignTrailingComments: true

...
